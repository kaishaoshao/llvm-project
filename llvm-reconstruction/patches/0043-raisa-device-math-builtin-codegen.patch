   // Required for overloaded intrinsics.
   llvm::SmallVector<llvm::Type *, 2> IntrinsicTypes;
+
+  // RAISA (`__raisa_*`) device-math helpers need one helper that the plain
+  // `ID`/`IntrinsicTypes` epilogue cannot express: the four
+  // `__raisa_fadd_{rn,ru,rz,rd}_*` families lower to
+  // `llvm.experimental.constrained.fadd` with an explicit rounding mode and
+  // `fpexcept.ignore`.  All of this was recovered from the vendor's own
+  // `-emit-llvm` output, e.g. for `__raisa_fadd_rn_f`:
+  //
+  //   %7 = call float @llvm.experimental.constrained.fadd.f32(
+  //            float %5, float %6, metadata !"round.tonearest",
+  //            metadata !"fpexcept.ignore") #5      ; attributes #5 = strictfp
+  auto EmitRAISAConstrainedFAdd = [&](StringRef RoundingMode) -> Value * {
+    llvm::LLVMContext &Ctx = getLLVMContext();
+    llvm::Function *F = CGM.getIntrinsic(
+        Intrinsic::experimental_constrained_fadd, {ResultType});
+    llvm::Value *Args[] = {
+        Ops[0], Ops[1],
+        llvm::MetadataAsValue::get(
+            Ctx, llvm::MDString::get(Ctx, RoundingMode)),
+        llvm::MetadataAsValue::get(
+            Ctx, llvm::MDString::get(Ctx, "fpexcept.ignore"))};
+    // The vendor's call site carries exactly one attribute, `strictfp`
+    // (`attributes #5 = { strictfp }` in its -emit-llvm output) -- it does
+    // *not* copy the declaration's attribute list onto the call.
+    llvm::CallInst *CI = Builder.CreateCall(F, Args);
+    Builder.setConstrainedFPCallAttr(CI);
+    return CI;
+  };
+
