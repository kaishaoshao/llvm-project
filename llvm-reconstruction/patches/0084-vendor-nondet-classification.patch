+                                options=cell_opts[c] + NONDET_VARIANT)
+        variant[c] = norm_s(out)
     n_same = n_diff = n_gap = n_perm = n_vnondet_diff = 0
+    n_vnondet_pass = 0
+    cell_verdict = {}
     for c in cells:
         row = []
         for f, norm in (("asm", norm_s), ("obj", norm_o)):
@@ -252,6 +289,12 @@
             elif v == o:
                 row.append("%s:IDENTICAL" % f)
