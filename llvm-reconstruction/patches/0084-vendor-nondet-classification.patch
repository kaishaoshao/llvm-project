 R4_RE = re.compile(r"gmem|generic|indirection", re.I)
 COMMENT = re.compile(r"\s+#.*$")
 
+# Cells whose multi-variable shared-memory *layout* is decided by the vendor's
+# pointer-keyed container, i.e. by process heap state rather than by the IR
+# (see tools/raisa_oracle.py::VENDOR_NONDET_CELLS for the full evidence:
+# 8/8 md5-identical per fixed command line under `setarch -R`, but adding a
+# diagnostic-only flag flips `b@+0,a@+576` <-> `a@+0,b@+128`, the latter being
+# our layout).  Byte identity is not a well-defined target for them: they get
+# their own verdict, are excluded from the byte-diff attribution, and are *not*
+# counted as byte-identical (the caller gets both numbers).
+VENDOR_NONDET_CELLS = {
