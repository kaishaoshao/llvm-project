+/// Vendor fork (`IsInstrDemandMaskPolicyUnderSIMT`, decompiled from
+/// libLLVMRISCVCodeGen.a).  Under the RAISA SIMT mode the "does this
+/// instruction care about the mask policy" question is not answered by the
+/// `UsesMaskPolicy` TSFlags bit of the instruction itself but by this predicate.
+///
+/// Semantics taken verbatim from the vendor decompilation:
+///   1. If \p MI has a masked counterpart, start from that (masked) pseudo's
+///      `UsesMaskPolicy` bit -- this is the `>> 0x10 & 1` bit of its TSFlags.
+///   2. (The vendor also forces the result for a small set of MC opcodes; those
+///      are indices into the vendor's instruction enum and could not be mapped
+///      onto this tree's numbering.  They only affect instructions whose
+///      destination EEW is not 1 bit; no reproduced RAISA cell reaches them.)
+///   3. A destination EEW of 1 bit (a mask producing operation) always demands
+///      the mask policy.
+///   4. When \p IsMaskAgnostic is non-null and the instruction demands the
+///      policy, it receives `destination EEW == 1 bit`, i.e. the demanded mask
+///      policy is *agnostic* for mask producing ops and *undisturbed* (`mu`,
+///      VMA = 0) for everything else.
+static bool IsInstrDemandMaskPolicyUnderSIMT(const MachineInstr &MI,
+                                            const RISCVSubtarget *ST,
+                                            bool *IsMaskAgnostic) {
+  bool Demand = false;
+  if (const RISCV::RISCVMaskedPseudoInfo *Masked =
+          RISCV::lookupMaskedIntrinsicByUnmasked(MI.getOpcode()))
+    Demand = ST->getInstrInfo()->get(Masked->MaskedPseudo).TSFlags &
+             RISCVII::UsesMaskPolicyMask;
+
+  const MCInstrDesc &Desc = MI.getDesc();
+  unsigned DestEEW =
+      (Desc.TSFlags & RISCVII::DestEEWMask) >> RISCVII::DestEEWShift;
+  if (DestEEW == 0)
+    Demand = true;
+
+  if (IsMaskAgnostic && Demand)
+    *IsMaskAgnostic = DestEEW == 0;
+  return Demand;
+}
