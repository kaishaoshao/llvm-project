+/// Vendor fork, verbatim from the decompiled `runOnMachineFunction`
+/// (lines 8082-8086 of tools/re/out/RISCVInsertVSETVLI/decompiled.c):
+///
+///   if ((subtarget[0x21b] == 0) || (subtarget[0x34] != 0x2a))  SIMTMode = 0;
+///   else                                                       SIMTMode = 1;
+///
+/// The member names were unresolved in the decompilation, but the offsets are
+/// now pinned down against this tree's `-fdump-record-layouts`:
+///   * RISCVSubtarget + 0x21b is `bool HasVendorXTsm82s` (feature at byte 539),
+///   * RISCVSubtarget + 0x34  is `Triple::OSType OS` (MCSubtargetInfo's Triple
+///     member at byte 52), and 0x2a == 42 == `Triple::RAISA`.
+/// So the predicate is "the xtsm82s feature is on and the target OS is RAISA",
+/// i.e. the `riscv64-unknown-raisa` device triple.  The vendor additionally
+/// gates the *emission* of VSET_SIMT on `CallingConv::RPU_KERNEL` (0x7c).
+static bool isSIMTMode(const RISCVSubtarget *ST) {
+  return ST->hasVendorXTsm82s() &&
+         ST->getTargetTriple().getOS() == Triple::RAISA;
+}
