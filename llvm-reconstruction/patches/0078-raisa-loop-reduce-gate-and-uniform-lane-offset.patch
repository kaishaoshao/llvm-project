+/// True if \p V is the lane id or (transitively) derived from it.  Used to tell
+/// a *uniform* byte offset (a loop-carried induction variable) apart from a
+/// per-lane one, which would make the address lane-dependent in a way no
+/// attested shape covers.  Constants and parameters (the packed block) are
+/// uniform by construction; the visited set cuts the phi/back-edge cycles.
+static bool dependsOnTid(const Value *V, const Value *Tid,
+                         SmallPtrSetImpl<const Value *> &Visited) {
+  if (V == Tid)
+    return true;
+  if (isa<Constant>(V) || isa<Argument>(V))
+    return false;
+  if (!Visited.insert(V).second)
+    return false;
+  if (const auto *I = dyn_cast<Instruction>(V))
+    for (const Value *Op : I->operands())
+      if (dependsOnTid(Op, Tid, Visited))
+        return true;
+  return false;
+}
