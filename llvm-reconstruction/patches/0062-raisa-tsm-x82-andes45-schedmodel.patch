 void RISCVSubtarget::anchor() {}
 
+#ifdef __TSM_RISCV__
+/// Vendor fork (TX8 / tsm-x82) scheduling model selection.
+///
+/// Mechanical reconstruction of
+///   libLLVMRISCVCodeGen.a(RISCVSubtarget.cpp.o)::getSchedModelForCPU
+/// (disassembly in wt-raisa-c/logs/SCHED_FINDINGS.md): the vendor rewrites the
+/// `tsm-x82` tune CPU to `andes-45-series` unless `EnableTX8SchedStrategy`
+/// (the vendor's `-mllvm -riscv-tx8-sched`) is set, and then tail-calls the
+/// generic lookup.  TX82Model therefore only ever reaches the *codegen*
+/// scheduler when the TX8 scheduling strategy is on; the static MC table entry
+/// for tsm-x82 still points at TX82Model, which is what `llvm-mca` and the
+/// vendor's `TX82ModelSchedClasses[]` expose.
+///
+/// The TX8 scheduling strategy is not implemented in this tree, so the
+/// substitution is unconditional -- byte-for-byte the vendor's default
+/// configuration.
+const MCSchedModel &RISCVSubtarget::getSchedModelForCPU(StringRef CPU) const {
+  if (CPU == "tsm-x82")
+    CPU = "andes-45-series";
+  return MCSubtargetInfo::getSchedModelForCPU(CPU);
+}
+#endif
