+    uint64_t InnerOff = 0;
+    if (!laneAddrOf(GEP->getPointerOperand(), Tid, Inner, InnerOff))
+      return false;
+    Base = Inner;
+    Off = InnerOff + C->getSExtValue();
+    return true;
+  }
+  return false;
