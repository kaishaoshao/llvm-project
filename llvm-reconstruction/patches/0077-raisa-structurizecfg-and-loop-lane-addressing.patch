+///   %b = getelementptr i32, ptr %p, i32 %tid        ; Base = %p,  Off = 0
+///   %a = getelementptr i8,  ptr %b, i32 <const>     ; Base = %p,  Off = <const>
+/// The vendored pass turns the first into a unit-stride `vle` from `%p` (the
+/// lanes are contiguous) and every other one into a `vluxei.sync` gather whose
+/// per-lane index vector is `vslh(Base_low + lane_bytes + Off, Base_high)`.
+static bool laneAddrOf(const Value *Ptr, const Value *Tid, Value *&Base,
+                       uint64_t &Off) {
+  const auto *GEP = dyn_cast<GetElementPtrInst>(Ptr);
+  if (!GEP)
+    return false;
+  if (indexedByTid(GEP, Tid)) {
+    Base = const_cast<Value *>(GEP->getPointerOperand());
+    Off = 0;
+    return true;
+  }
