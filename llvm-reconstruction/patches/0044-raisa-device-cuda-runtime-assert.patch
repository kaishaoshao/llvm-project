+         // short-circuiting on RAISAIsDevice reproduces that Release behaviour
+         // instead of tripping the null-runtime assertion.
+         getLangOpts().RAISAIsDevice ||
          (getContext().getAuxTargetInfo() &&
           (getContext().getAuxTargetInfo()->getCXXABI() !=
            getContext().getTargetInfo().getCXXABI())) ||
