 let IsRVVWideningReduction = 1, mayRaiseFPException = true in {
@@ -6677,6 +6723,51 @@
 
 } // Predicates = [HasVInstructionsAnyF]
 
+// `AllFloatVectors` carries the bf16 types next to the f16/f32/f64 ones, so the
+// patterns have to be split: bf16 goes to the `_BFloat16_` twin, everything else
+// to the plain pseudo.  (Both are still generated for bf16 -- only the *routing*
+// changes -- so the two lists are disjoint and together cover AllFloatVectors.)
+// These must live outside the `let Predicates = ... in { }` block above: a `{ }`
+// block introduces a scope, and `defvar`s declared inside it are not visible to
+// the pattern section further down.
+defvar VPNONBF16FloatVectors =
+  !filter(vti, AllFloatVectors, !not(!eq(vti.Scalar, bf16)));
+defvar VPBF16FloatVectors =
+  !filter(vti, AllFloatVectors, !eq(vti.Scalar, bf16));
+
+// The bf16 M1 accumulator / scalar-operand type (`vbfloat16m1_t`).  The upstream
+// reduction multiclasses derive the M1 type from the SEW alone
+// (`!cast<VTypeInfo>("VF16M1")`), which is `vfloat16m1_t` -- *not* the bf16 M1 --
+// and that type mismatch is exactly why bf16 `vfred{usum,max,min}` had no
+// matching pattern at all (`Cannot select: intrinsic %llvm.riscv.vfredusum`).
+defvar VPBF16M1 = !cast<VTypeInfo>("VBF16M1");
+
+// Same lowerings as `VPatReductionV_VS{,_RM}`, but over an explicit type list so
+// the bf16 types can pick the `_BFloat16_` twin and the bf16 M1 accumulator.
+multiclass VPatXTsmReductionV_VS<string intrinsic, string instruction,
+                                 list<VTypeInfo> vtilist> {
+  foreach vti = vtilist in {
+    defvar m1 = !if(!eq(vti.Scalar, bf16), VPBF16M1,
+                    !cast<VTypeInfo>("VF" # vti.SEW # "M1"));
+    let Predicates = GetVTypePredicates<vti>.Predicates in
+    defm : VPatTernaryTU<intrinsic, instruction, "VS",
+                         m1.Vector, vti.Vector, m1.Vector, vti.Mask,
+                         vti.Log2SEW, vti.LMul, VR, vti.RegClass, VR>;
+  }
+}
+
+multiclass VPatXTsmReductionV_VS_RM<string intrinsic, string instruction,
+                                    list<VTypeInfo> vtilist> {
+  foreach vti = vtilist in {
+    defvar m1 = !if(!eq(vti.Scalar, bf16), VPBF16M1,
+                    !cast<VTypeInfo>("VF" # vti.SEW # "M1"));
+    let Predicates = GetVTypePredicates<vti>.Predicates in
+    defm : VPatTernaryTURoundingMode<intrinsic, instruction, "VS",
+                                     m1.Vector, vti.Vector, m1.Vector, vti.Mask,
+                                     vti.Log2SEW, vti.LMul, VR, vti.RegClass, VR>;
+  }
+}
