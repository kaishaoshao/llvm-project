 //===----------------------------------------------------------------------===//
+// TSM fork (RAISA) : `_BFloat16_` twin pseudo families
+//
+// The vendor gives the bf16 form of every CT floating-point vector instruction
+// its own pseudo, named by inserting `BFloat16_` after the opcode
+// (`PseudoVFADD_BFloat16_VV_M1_E16` alongside `PseudoVFADD_VV_M1_E16`), and
+// demands bit 8 of VTYPE on exactly that set.  The set was recovered verbatim
+// from the vendor's own per-opcode tables (`RISCV::getCTPseudoInfoByBF16` /
+// `getCTPseudoInfoByHalf` in `libLLVMRISCVDesc.a(RISCVBaseInfo.cpp.o)`): 540
+// `{bf16-pseudo, f16-twin}` pairs, every `First` side a `_BFloat16_` name and
+// every `Second` side its f16 sibling -- see recon/bf16/ct_bit8_pairs.tsv and
+// recon/bf16/ct_bit8_report.txt (540/540 resolved, 0 unresolved).
+//
+// Reproducing the twins is the *only* way to keep the demand per-opcode here:
+// without them f16 and bf16 share one pseudo, and the MIR cannot tell them
+// apart (`LLT` has no bf16 kind, so `RISCVInsertVSETVLI` cannot recover the
+// element type from the register type either).  Each twin re-instantiates the
+// family's own pseudo multiclass under the `_BFloat16` prefix, so operands,
+// register classes and scheduling class are identical to the f16 sibling by
+// construction; only the name and `AltFmtType` differ.
+//
+// `AltFmtType` is TSFlags bit 26 (`RISCVII::hasAltFmtType`); it is consumed at
+// the vsetvli *emission* point in `RISCVInsertVSETVLI.cpp`
+// (`transferBefore` -> `encodeVTYPE` -> `PseudoVSETVLI*`), not merely in
+// `DemandedFields`.
+//
+// NOTE: re-instantiating the whole multiclass also creates `_E32`/`_E64` twins,
+// which the vendor does not have and which no pattern references (bf16 is only
+// ever 16-bit).  The **E16 subset** is what must match the vendor name for name;
+// `recon/bf16/` records that comparison.
+//===----------------------------------------------------------------------===//
+let AltFmtType = 1 in {
+  let mayRaiseFPException = true in {
+    defm PseudoVFADD_BFloat16    : VPseudoVALU_VV_VF_RM;
+    defm PseudoVFSUB_BFloat16    : VPseudoVALU_VV_VF_RM;
+    defm PseudoVFMUL_BFloat16    : VPseudoVFMUL_VV_VF_RM;
+    defm PseudoVFMIN_BFloat16    : VPseudoVMAX_VV_VF;
+    defm PseudoVFMAX_BFloat16    : VPseudoVMAX_VV_VF;
+    defm PseudoVFRSQRT7_BFloat16 : VPseudoVRCP_V;
+    defm PseudoVFREC7_BFloat16   : VPseudoVRCP_V_RM;
+    defm PseudoVFREDUSUM_BFloat16 : VPseudoVFRED_VS_RM;
+    defm PseudoVFREDMIN_BFloat16  : VPseudoVFREDMINMAX_VS;
+    defm PseudoVFREDMAX_BFloat16  : VPseudoVFREDMINMAX_VS;
+  }
+}
