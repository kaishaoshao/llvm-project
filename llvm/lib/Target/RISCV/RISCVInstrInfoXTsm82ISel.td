def : Pat<(int_riscv_lsu_set_rdma_dst_itera_stride GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_LSU_SET_RDMA_DST_ITERA_STRIDE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_set_rdma_hwc GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_LSU_SET_RDMA_HWC GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_set_rdma_src_itera_stride GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_LSU_SET_RDMA_SRC_ITERA_STRIDE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_set_tdma_hwc GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_LSU_SET_TDMA_HWC GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_set_wdma_dst_itera_stride GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_LSU_SET_WDMA_DST_ITERA_STRIDE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_set_wdma_hwc GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_LSU_SET_WDMA_HWC GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_set_wdma_src_itera_stride GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_LSU_SET_WDMA_SRC_ITERA_STRIDE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_tdma_bank_scatter GPR:$rd, GPR:$rs1),
          (XTsm_LSU_TDMA_BANK_SCATTER GPR:$rd, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_tdma_mem_copy GPR:$rd, GPR:$rs1),
          (XTsm_LSU_TDMA_MEM_COPY GPR:$rd, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_tdma_nchw2nhwc GPR:$rd, GPR:$rs1),
          (XTsm_LSU_TDMA_NCHW2NHWC GPR:$rd, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_tdma_nhwc2nchw GPR:$rd, GPR:$rs1),
          (XTsm_LSU_TDMA_NHWC2NCHW GPR:$rd, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_wdma_gather GPR:$rd, GPR:$rs1),
