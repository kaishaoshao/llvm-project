def : Pat<(int_riscv_lsu_rdma_mem_copy GPR:$rd, GPR:$rs1),
          (XTsm_LSU_RDMA_MEM_COPY GPR:$rd, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_rdma_mem_set GPR:$rd, GPR:$rs1),
          (XTsm_LSU_RDMA_MEM_SET GPR:$rd, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_rdma_scatter GPR:$rd, GPR:$rs1),
          (XTsm_LSU_RDMA_SCATTER GPR:$rd, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_set_length GPR:$rd, GPR:$rs2, GPR:$rs1),
