def : Pat<(int_riscv_lsu_wdma_index_scatter GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_LSU_WDMA_INDEX_SCATTER GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_wdma_mem_copy GPR:$rd, GPR:$rs1),
