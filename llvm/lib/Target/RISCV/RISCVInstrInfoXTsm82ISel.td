//
// Instruction selection for the XTsm82s ("TSM X82") intrinsics.
//
// !!! The Pat<> list in this file is GENERATED by
// !!! wt-isel/tools/gen_isel_patterns.py from the vendor compiler's observed
// !!! behaviour (wt-isel/out/builtin_inventory.json).  Edit the generator, not
// !!! the list.
//
// Background
// ----------
// RISCVInstrInfoXTsm82s.td models the XTsm82s instructions and
// IntrinsicsRISCVXTsm.td declares the intrinsics (exposed as
// __builtin_riscv_*), but the recovered drop contains no ISel patterns at all,
// so SelectionDAG aborts with e.g.
//   "Cannot select: intrinsic %llvm.riscv.set.barrier".
//
// Method
// ------
// For every builtin the vendor clang accepts, a minimal probe is compiled with
// the vendor compiler and both the MIR at finalize-isel
// (`-mllvm -print-after=finalize-isel`) and the final disassembly are recorded.
// Two properties hold for *every* one of the builtins below:
//
//   1. the selected instruction has NO explicit def -- the vendor MIR shows no
//      `%n =`, so the register slot encoded in Inst{11-7} is an *input*
//      operand.  The corresponding definitions in RISCVInstrInfoXTsm82s.td were
//      therefore changed from `(outs GPR:$rd), (ins ...)` to
//      `(outs), (ins GPR:$rd, ...)`.  No encoding and no assembly text changes:
//      the AsmString is untouched, and because outs are listed before ins,
//      prepending rd to ins preserves the MC operand order.  Only
//      MCInstrDesc::NumDefs changes, 1 -> 0, which is what the vendor has.
//      (The two kcore_* builtins are the exception -- that instruction does
//      have a def; see the notes next to their patterns.)
//   2. the intrinsic arguments map 1:1 onto the register slots in *assembly
//      order*.  Probe-verified: passing 0x1000/0x1008/0x1010 to a 3-argument
//      builtin selects `mnemonic a0, a1, a2` with a0/a1/a2 holding exactly
//      those values in that order.
//
// The memory/side-effect flags of an instruction must equal the intrinsic's
// attributes, otherwise TableGen hard-errors ("Pattern doesn't match
// mayStore = 0").  The rule used (verified against the vendor's own accepted
// pattern set) is:
//     IntrNoMem              -> no memory flags
//     IntrWriteMem           -> mayStore
//     (no memory attribute)  -> mayLoad + mayStore
//     IntrHasSideEffects     -> hasSideEffects
//
//===----------------------------------------------------------------------===//

// The flush/invalidate/prefetch forms take a constant in their middle operand
// slot.  The vendor is permissive about it -- it prints any value verbatim
// (assembler probe: `l0_flush a0, 4104, a1` for 0x1008) and the encoder keeps
// the low 5 bits -- so the pattern matches the generic unconstrained `imm`
// leaf.  That also matters mechanically: TableGen only converts a *named*
// pattern operand into a target immediate when its operator is literally
// "imm" (see EmitResultOfNamedOperand in DAGISelMatcherGen.cpp) -- and that
// check looks at the *destination* node, so both sides of the Pat must be
// spelled `imm:$imm`.  With `XTsmUImm5:$imm` on the right the value was left in
// a register and RISCVMCCodeEmitter::getImmOpValue asserted.
//
let Predicates = [HasVendorXTsm82s] in {

def : Pat<(int_riscv_conv GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_CONV GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_convbw GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_CONVBW GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_convbw_psum GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_CONVBW_PSUM GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_conv_psum GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_CONV_PSUM GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_direct_write GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DIRECT_WRITE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_gather GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_GATHER GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_gather_scatter_g2l GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_GATHER_SCATTER_G2L GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_gather_scatter_l2g GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_GATHER_SCATTER_L2G GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_index_gather GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_INDEX_GATHER GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_index_scatter GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_INDEX_SCATTER GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_scatter GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_SCATTER GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_set_length GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_SET_LENGTH GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_set_rdma_dst_itera_stride GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_SET_RDMA_DST_ITERA_STRIDE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_set_rdma_misc GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_SET_RDMA_MISC GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_set_rdma_src_itera_stride GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_SET_RDMA_SRC_ITERA_STRIDE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_set_wdma_dst_itera_stride GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_SET_WDMA_DST_ITERA_STRIDE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_set_wdma_misc GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_SET_WDMA_MISC GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_dte_set_wdma_src_itera_stride GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_DTE_SET_WDMA_SRC_ITERA_STRIDE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_gemm GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_GEMM GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_gemm_psum GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_GEMM_PSUM GPR:$rd, GPR:$rs2, GPR:$rs1)>;

// No arguments but three register slots: the vendor pins all to x0.
def : Pat<(int_riscv_inst_barrier),
          (XTsm_INST_BARRIER (XLenVT X0), (XLenVT X0), (XLenVT X0))>;

def : Pat<(int_riscv_kcore_ncc_read GPR:$rs2),
          (XTsm_KCORE_NCC_READ GPR:$rs2)>;

// No argument, one result.  The vendor MIR is
//   %0:gpr = Kcore_Wait $x0      (asm: kcore_wait a0, zero)
// so this instruction *does* have a def (the result) and its only input
// slot is pinned to x0 -- no reshape, just a pinned pattern.
def : Pat<(int_riscv_kcore_wait),
          (XTsm_KCORE_WAIT (XLenVT X0))>;

def : Pat<(int_riscv_l0_flush GPR:$rd, imm:$imm, GPR:$rs1),
          (XTsm_L0_FLUSH GPR:$rd, imm:$imm, GPR:$rs1)>;

def : Pat<(int_riscv_l0_invalid GPR:$rd, imm:$imm, GPR:$rs1),
          (XTsm_L0_INVALID GPR:$rd, imm:$imm, GPR:$rs1)>;

def : Pat<(int_riscv_l0_set_src_itera GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_L0_SET_SRC_ITERA GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_l0_set_src_stride GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_L0_SET_SRC_STRIDE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_l1_flush GPR:$rd, imm:$imm, GPR:$rs1),
          (XTsm_L1_FLUSH GPR:$rd, imm:$imm, GPR:$rs1)>;

def : Pat<(int_riscv_l1_invalid GPR:$rd, imm:$imm, GPR:$rs1),
          (XTsm_L1_INVALID GPR:$rd, imm:$imm, GPR:$rs1)>;

def : Pat<(int_riscv_l1_set_src_itera GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_L1_SET_SRC_ITERA GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_l1_set_src_stride GPR:$rd, GPR:$rs2, GPR:$rs1),
          (XTsm_L1_SET_SRC_STRIDE GPR:$rd, GPR:$rs2, GPR:$rs1)>;

def : Pat<(int_riscv_l1_sw_prefetch GPR:$rd, imm:$imm, GPR:$rs1),
          (XTsm_L1_SW_PREFETCH GPR:$rd, imm:$imm, GPR:$rs1)>;

def : Pat<(int_riscv_lsu_rdma_gather GPR:$rd, GPR:$rs1),
