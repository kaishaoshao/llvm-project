def XTsm_WAIT_RECV : XTsm82sInst<(outs), (ins GPR:$rd, GPR:$rs2, GPR:$rs1), "wait_recv", "$rd, $rs2, $rs1", [HasVendorXTsm82s]> {
  let Inst{6-0} = 0b1111011;
  let Inst{14-12} = 0b000;
  let Inst{31-25} = 0b1110001;
  let Inst{11-7} = rd;
  let Inst{19-15} = rs1;
  let Inst{24-20} = rs2;
  let mayLoad = 1;
  let mayStore = 1;
  let hasSideEffects = 1;
}

