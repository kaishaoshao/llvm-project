// vsetvli: vtype is the standard 11-bit VTYPE image in bits 30..20.
// (The vendor encoder additionally sets reserved vtype bits 10/9 when rd
// and/or rs1 is x0; that quirk is documented in the port report.)
def XTsm_VSETVLI : XTsm82sInst<(outs GPR:$rd),
                             (ins GPR:$rs1, VTypeIOp11:$vtypei),
                             "vsetvli", "$rd, $rs1, $vtypei",
                             [HasVendorXTsm82s, HasVInstructions]> {
  let Inst{6-0}   = 0b1111011;
  let Inst{14-12} = 0b111;
  let Inst{30-20} = vtypei;
  let Inst{19-15} = rs1;
  let Inst{11-7}  = rd;
}

// vmv.v.v: two encoding classes with different operand layouts.
// The assembler reaches the funct6=61 class (source in rs2);
// the funct6=55 class (source in rs1) is decode-only.
def XTsm_VMV_V_V : XTsm82sInst<(outs VR:$vd),
                             (ins VR:$vs2),
                             "vmv.v.v", "$vd, $vs2",
                             [HasVendorXTsm82s, HasVInstructions]> {
  let Inst{6-0}   = 0b1111011;
  let Inst{14-12} = 0b101;
  let Inst{25}    = 1;
  let Inst{31-26} = 0b111101;
  let Inst{24-20} = vs2;
  let Inst{19-15} = 0;
  let Inst{11-7}  = vd;
}
def XTsm_VMV_V_V_P1 : XTsm82sInst<(outs VR:$vd),
                               (ins VR:$vs1),
                               "vmv.v.v", "$vd, $vs1",
                               [HasVendorXTsm82s, HasVInstructions]> {
  let AsmVariantName = "tx8decodeonly";
  let Inst{6-0}   = 0b1111011;
  let Inst{14-12} = 0b001;
  let Inst{25}    = 1;
  let Inst{31-26} = 0b110111;
  let Inst{24-20} = 0;
  let Inst{19-15} = vs1;
  let Inst{11-7}  = vd;
}

//===----------------------------------------------------------------------===//
// Mnemonics the vendor renders as aliases of another XTsm82s instruction
//===----------------------------------------------------------------------===//

let Predicates = [HasVendorXTsm82s, HasVInstructions] in
def : InstAlias<"vfneg.v $vd, $vs$vm",
                (XTsm_VFSGNJN_VV VR:$vd, VR:$vs, VR:$vs, VMaskOp:$vm)>;
let Predicates = [HasVendorXTsm82s, HasVInstructions] in
def : InstAlias<"vfneg.v $vd, $vs",
                (XTsm_VFSGNJN_VV VR:$vd, VR:$vs, VR:$vs, zero_reg)>;

let Predicates = [HasVendorXTsm82s, HasVInstructions] in
def : InstAlias<"vfabs.v $vd, $vs$vm",
                (XTsm_VFSGNJX_VV VR:$vd, VR:$vs, VR:$vs, VMaskOp:$vm)>;
let Predicates = [HasVendorXTsm82s, HasVInstructions] in
def : InstAlias<"vfabs.v $vd, $vs",
                (XTsm_VFSGNJX_VV VR:$vd, VR:$vs, VR:$vs, zero_reg)>;

let Predicates = [HasVendorXTsm82s, HasVInstructions] in
def : InstAlias<"vmmv.m $vd, $vs",
                (XTsm_VMAND_MM VR:$vd, VR:$vs, VR:$vs)>;

let Predicates = [HasVendorXTsm82s, HasVInstructions] in
def : InstAlias<"vmnot.m $vd, $vs",
                (XTsm_VMNAND_MM VR:$vd, VR:$vs, VR:$vs)>;

let Predicates = [HasVendorXTsm82s, HasVInstructions] in
def : InstAlias<"vmclr.m $vd",
                (XTsm_VMXOR_MM VR:$vd, VR:$vd, VR:$vd)>;

let Predicates = [HasVendorXTsm82s, HasVInstructions] in
def : InstAlias<"vmset.m $vd",
                (XTsm_VMXNOR_MM VR:$vd, VR:$vd, VR:$vd)>;

let Predicates = [HasVendorXTsm82s, HasVInstructions] in
def : InstAlias<"vneg.v $vd, $vs$vm",
                (XTsm_VRSUB_VX VR:$vd, VR:$vs, X0, VMaskOp:$vm)>;
let Predicates = [HasVendorXTsm82s, HasVInstructions] in
def : InstAlias<"vneg.v $vd, $vs",
                (XTsm_VRSUB_VX VR:$vd, VR:$vs, X0, zero_reg)>;

