def XTsm_VXOR_VS : XTsm82sInst<(outs VR:$vd), (ins VR:$vs2, VR:$vs1, VMaskOp:$vm), "vxor.vs", "$vd, $vs2, $vs1$vm", [HasVendorXTsm82s]> {
  let RVVConstraint = VMConstraint;
  let Inst{6-0} = 0b1111011;
  let Inst{14-12} = 0b010;
  let Inst{31-26} = 0b011000;
  let Inst{11-7} = vd;
  let Inst{19-15} = vs1;
  let Inst{24-20} = vs2;
  let Inst{25} = vm;
}

