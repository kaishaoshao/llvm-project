// XTsm82s ("TSM X82") custom instruction set, reconstructed from the
// vendor assembler/disassembler (docs/xtsm82s_isa.md).  Every instruction
// is opcode 0x7b (CUSTOM_3); TX8 re-encodes standard RVV into this space.
//
// This file models the assembly and disassembly layer only.  Instruction
// selection, the TX8* backend passes, the TX8 scheduling model and the
// fork's vector legality restrictions are not reconstructed here -- the
// corresponding source does not exist in the recovered drop.
//===----------------------------------------------------------------------===//

//===----------------------------------------------------------------------===//
// XTsm82s scalar/stream (SR) register file: sr0..sr31
//
// Each SR register is one 128-bit SIMT mask.  Together with `$exec` this is the
// register file that carries the "(B)" EXEC/mask family:
//
//     <1 x i128> and_s / nor_s / mov128.s.v   ->  def SR
//     isetexec                                ->  use  SR, def $exec
//
// The values are real allocatable values (the vendor's post-RA MIR shows them
// in $s0/$s1...), so the class is allocatable and its register info is 128 bits
// wide -- the reconstructed asm layer had it as a non-allocatable `untyped`
// class because nothing selected into it yet.
//===----------------------------------------------------------------------===//

foreach Index = 0-31 in {
  def SR#Index : RISCVReg<Index, "sr"#Index>,
                 DwarfRegNum<[!add(Index, 3104)]>;
}

def XTsmSRRI : RegInfoByHwMode<[RV32, RV64],
                               [RegInfo<128, 128, 128>,
                                RegInfo<128, 128, 128>]>;

let RegInfos = XTsmSRRI in
def SR : RISCVRegisterClass<[v1i128], 128,
                             (add (sequence "SR%u", 0, 31))> {
  let isAllocatable = 1;
}

// 5-bit unsigned immediate used by the XTsm82s immediate forms.
def XTsmUImm5 : RISCVUImmOp<5>;

// Base class: every XTsm82s instruction fixes opcode bits 6..0 to 0x7b.
class XTsm82sInst<dag outs, dag ins, string mnem, string asmops,
                   list<Predicate> preds>
    : RVInst<outs, ins, mnem, asmops, [], InstFormatOther> {
  // Operand variables referenced by the Inst{...} assignments below.
  // The code emitter and the disassembler map these names back to the
  // operands named in the DAG above.
  bits<5> rd;
  bits<5> rs1;
  bits<5> rs2;
  bits<5> vd;
  bits<5> vs1;
  bits<5> vs2;
  bits<5> imm;
  bits<11> vtypei;
  bit vm;
  let Predicates = preds;
  // XTsm82s gets its own decoder table so that opcode 0x7b does not
  // have to disambiguate against every standard instruction; the table
  // is registered last in RISCVDisassembler.cpp's DecoderList32.
  let DecoderNamespace = "XTsm";
  // These three cannot be inferred: the defs carry no isel pattern.
  // Per-instruction overrides are emitted for the memory families.
  let hasSideEffects = 0;
  let mayLoad = 0;
  let mayStore = 0;
}

