//===----------------------------------------------------------------------===//
// XTsm82s scalar/stream (SR) register file: sr0..sr31
//
// These registers live in the 5-bit operand slots but are not part of
// the integer register file, so the class is not allocatable.
//===----------------------------------------------------------------------===//

foreach Index = 0-31 in {
  def SR#Index : RISCVReg<Index, "sr"#Index>,
                 DwarfRegNum<[!add(Index, 3104)]>;
}

let RegInfos = XLenRI in
def SR : RISCVRegisterClass<[untyped], 32,
                             (add (sequence "SR%u", 0, 31))> {
  let isAllocatable = 0;
}

// 5-bit unsigned immediate used by the XTsm82s immediate forms.
def XTsmUImm5 : RISCVUImmOp<5>;

// Base class: every XTsm82s instruction fixes opcode bits 6..0 to 0x7b.
class XTsm82sInst<dag outs, dag ins, string mnem, string asmops,
                   list<Predicate> preds>
    : RVInst<outs, ins, mnem, asmops, [], InstFormatOther> {
  // Operand variables referenced by the Inst{...} assignments below.
  // The code emitter and the disassembler map these names back to the
  // operands named in the DAG above.
  bits<5> rd;
  bits<5> rs1;
  bits<5> rs2;
  bits<5> vd;
  bits<5> vs1;
  bits<5> vs2;
  bits<5> imm;
  bits<11> vtypei;
  bit vm;
  let Predicates = preds;
  // XTsm82s gets its own decoder table so that opcode 0x7b does not
  // have to disambiguate against every standard instruction; the table
  // is registered last in RISCVDisassembler.cpp's DecoderList32.
  let DecoderNamespace = "XTsm";
  // These three cannot be inferred: the defs carry no isel pattern.
  // Per-instruction overrides are emitted for the memory families.
  let hasSideEffects = 0;
  let mayLoad = 0;
  let mayStore = 0;
}

